<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd"
      extends="pagebuilder_base_form">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">pagebuilder_aiwidget_form.pagebuilder_aiwidget_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Code</item>
    </argument>
    <settings>
        <deps>
            <dep>pagebuilder_aiwidget_form.pagebuilder_aiwidget_form_data_source</dep>
        </deps>
        <namespace>pagebuilder_aiwidget_form</namespace>
    </settings>
    <dataSource name="pagebuilder_aiwidget_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_PageBuilder/js/form/provider</item>
            </item>
        </argument>
        <dataProvider name="pagebuilder_aiwidget_form_data_source" class="Magento\PageBuilder\Model\ContentType\DataProvider">
            <settings>
                <requestFieldName/>
                <primaryFieldName/>
            </settings>
        </dataProvider>
    </dataSource>

    <!-- PageBuilder expects appearance to exist. Keep it, but hide it and force default. -->
    <fieldset name="hidden" sortOrder="5">
        <settings>
            <label/>
        </settings>

        <field name="appearance" formElement="hidden" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="default" xsi:type="string">default</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <dataScope>appearance</dataScope>
            </settings>
        </field>
    </fieldset>

    <fieldset name="general" sortOrder="20">
        <settings>
            <label/>
        </settings>

        <field name="prompt" sortOrder="10" formElement="textarea">
            <settings>
                <label translate="true">AI Prompt</label>
                <dataType>text</dataType>
                <additionalClasses>
                    <class name="aiwidget-prompt-field">true</class>
                </additionalClasses>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-string" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <button name="generate" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Gtstudio_AiWidgets/js/content-type/aiwidget</item>
                    <item name="generateUrl" xsi:type="url" path="aiwidgets/generate/index">
                        <param name="isAjax">true</param>
                    </item>
                    <item name="provider" xsi:type="string">pagebuilder_aiwidget_form.pagebuilder_aiwidget_form_data_source</item>
                    <item name="title" xsi:type="string" translate="true">Generate</item>
                    <item name="buttonClasses" xsi:type="string">action-default aiwidget-generate-button</item>
                    <item name="actions" xsi:type="array">
                        <item name="0" xsi:type="array">
                            <item name="targetName" xsi:type="string">${ $.name }</item>
                            <item name="actionName" xsi:type="string">onClick</item>
                        </item>
                    </item>
                </item>
            </argument>
        </button>
        <field name="html"
               formElement="textarea"
               sortOrder="30"
               component="Magento_PageBuilder/js/form/element/html-code"
               class="Magento\PageBuilder\Component\Form\HtmlCode">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">page</item>
                    <item name="visible" xsi:type="boolean">true</item>
                </item>
            </argument>
            <settings>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                    <class name="admin__font-console">true</class>
                    <class name="aiwidget-ai-border">true</class>
                </additionalClasses>
                <dataScope>html</dataScope>
                <dataType>text</dataType>
                <validation>
                    <rule name="validate-no-utf8mb4-characters" xsi:type="boolean">true</rule>
                </validation>
                <placeholder translate="true">Enter HTML, CSS or JavaScript code</placeholder>
                <notice translate="true">HTML code must be valid, all CSS &amp; JavaScript must be wrapped in their HTML elements.</notice>
            </settings>
        </field>
    </fieldset>
</form>
